meta {
  name: Allowed tenant / Locataire autorisé / Inquilino permitido
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/namespaces/{{allowedNamespace}}/agents/{{allowedAgent}}
  body: none
  auth: none
}

headers {
  x-api-key: {{restrictedKey}}
  accept: application/json
}

tests {
  test('OCC contract / Contrat OCC / Contrato OCC', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.data.id).to.equal(bru.getEnvVar('allowedAgent'));
  });
}
