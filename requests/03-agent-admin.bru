meta {
  name: Agent / Agent / Agente
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/namespaces/{{allowedNamespace}}/agents/{{allowedAgent}}
  body: none
  auth: none
}

headers {
  x-api-key: {{adminKey}}
  accept: application/json
}

tests {
  test('OCC contract / Contrat OCC / Contrato OCC', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.data.id).to.equal(bru.getEnvVar('allowedAgent')); expect(body.data.activeRevisionId).to.be.a('string');
  });
}
