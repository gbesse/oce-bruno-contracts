meta {
  name: Foreign agent exists / Agent étranger existant / Agente ajeno existente
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/namespaces/{{foreignNamespace}}/agents/{{foreignAgent}}
  body: none
  auth: none
}

headers {
  x-api-key: {{adminKey}}
  accept: application/json
}

tests {
  test('OCC contract / Contrat OCC / Contrato OCC', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.data.id).to.equal(bru.getEnvVar('foreignAgent'));
  });
}
